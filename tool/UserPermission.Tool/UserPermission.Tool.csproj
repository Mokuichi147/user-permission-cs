<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UserPermission.Tool</RootNamespace>
    <!-- net8.0 ビルドでも、より新しいランタイム (.NET 10 等) で実行できるようにする -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- .NET ツール (dnx / dotnet tool install) として配布 -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>user-permission</ToolCommandName>
    <PackageId>UserPermission.Tool</PackageId>
    <Version>0.2.0</Version>
    <Authors>mokuichi147</Authors>
    <Description>user-permission の .NET ツール。`serve` で同梱 HTTP サーバーを起動します。dnx / dotnet tool 対応。</Description>
    <PackageTags>auth;users;permissions;cli;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mokuichi147/user-permission-cs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mokuichi147/user-permission-cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/UserPermission/UserPermission.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Condition="Exists('../../README.md')" />
  </ItemGroup>

  <!--
    CI が用意した各 RID のネイティブライブラリを publish 出力 (= ツールパッケージ) へ同梱する。
    実行時は UserPermission.NativeLibraryResolver が runtimes/{rid}/native/ を探索して解決する。
    ローカルビルド時は runtimes/ が無いため、Directory.Build.targets がホスト RID の
    ライブラリを出力ディレクトリへコピーする (こちらは既定の解決で読み込まれる)。
  -->
  <ItemGroup Condition="Exists('../../runtimes')">
    <Content Include="../../runtimes/**/*.*"
             CopyToPublishDirectory="PreserveNewest"
             Link="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
             Pack="false" />
  </ItemGroup>

</Project>
